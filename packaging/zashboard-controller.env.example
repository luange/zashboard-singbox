LISTEN=127.0.0.1:9091
CORE_URL=http://127.0.0.1:9090
CORE_SERVICE=sing-box
UI_DIR=/usr/share/zashboard-singbox
PROVIDER_OVERRIDES=/etc/zashboard-controller/provider-overrides.json
CONFIG_BUILDER=/usr/local/sbin/singbox-build-runtime-config
BASE_CONFIG=/root/singbox/config.json
# Leave empty by default. Set to 1 only when the core UI has no API secret and
# Provider management should trust same-host browser origins on a private LAN.
TRUSTED_LAN_PROVIDER_UI_ARG=
# OpenRC configuration files are sourced but not exported automatically.
# `export` also remains valid in systemd EnvironmentFile syntax.
export ZASHBOARD_CONTROLLER_TOKEN=replace-with-a-long-random-token
