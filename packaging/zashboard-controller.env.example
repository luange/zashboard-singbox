LISTEN=127.0.0.1:9091
CORE_URL=http://127.0.0.1:9090
CORE_SERVICE=sing-box
UI_DIR=/usr/share/zashboard-singbox
# OpenRC configuration files are sourced but not exported automatically.
# `export` also remains valid in systemd EnvironmentFile syntax.
export ZASHBOARD_CONTROLLER_TOKEN=replace-with-a-long-random-token
