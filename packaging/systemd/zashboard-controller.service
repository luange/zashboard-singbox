[Unit]
Description=Independent Zashboard UI and sing-box lifecycle controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/zashboard-controller.env
ExecStart=/usr/local/bin/zashboard-controller -listen ${LISTEN} -core ${CORE_URL} -service ${CORE_SERVICE} -supervisor systemd -ui ${UI_DIR} -provider-overrides ${PROVIDER_OVERRIDES} -config-builder ${CONFIG_BUILDER} -base-config ${BASE_CONFIG} ${TRUSTED_LAN_PROVIDER_UI_ARG}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/usr/share/zashboard-singbox
ReadWritePaths=/etc/zashboard-controller /run/singbox

[Install]
WantedBy=multi-user.target
